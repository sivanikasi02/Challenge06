
#include <stdio.h>

int main()
{
    int a[12], n, i, j, k, temp;
    int sum = 0, min, max;
    int second, found = 0;
    int peaks = 0, current = 1, longest = 1;
    int r, d, count = 0;

    do
    {
        printf("Enter N (5 to 12): ");
        scanf("%d", &n);
    } while (n < 5 || n > 12);

    for (i = 0; i < n; i++)
    {
        do
        {
            printf("Enter reading %d (0 to 1000): ", i + 1);
            scanf("%d", &a[i]);
        } while (a[i] < 0 || a[i] > 1000);
    }

    printf("\nOriginal readings: ");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    min = max = a[0];

    for (i = 0; i < n; i++)
    {
        sum += a[i];

        if (a[i] < min)
            min = a[i];

        if (a[i] > max)
            max = a[i];
    }

    printf("\nSum = %d", sum);
    printf("\nAverage = %.2f", (float)sum / n);
    printf("\nMinimum = %d", min);
    printf("\nMaximum = %d", max);

    for (i = 0; i < n; i++)
    {
        if (a[i] < max)
        {
            if (found == 0 || a[i] > second)
            {
                second = a[i];
                found = 1;
            }
        }
    }

    if (found)
        printf("\nSecond-largest distinct value = %d", second);
    else
        printf("\nNo second-largest distinct value exists");

    for (i = 1; i < n - 1; i++)
    {
        if (a[i] > a[i - 1] && a[i] > a[i + 1])
            peaks++;
    }

    printf("\nNumber of local peaks = %d", peaks);

    for (i = 1; i < n; i++)
    {
        if (a[i] > a[i - 1])
        {
            current++;

            if (current > longest)
                longest = current;
        }
        else
        {
            current = 1;
        }
    }

    printf("\nLongest increasing run = %d", longest);

    printf("\nEnter K: ");
    scanf("%d", &k);

    k = k % n;
    if (k < 0)
        k += n;

    for (i = 0; i < k; i++)
    {
        temp = a[n - 1];

        for (j = n - 1; j > 0; j--)
            a[j] = a[j - 1];

        a[0] = temp;
    }

    printf("\nRotated readings: ");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    do
    {
        printf("\nEnter last two digits of registration number (0 to 99): ");
        scanf("%d", &r);
    } while (r < 0 || r > 99);

    d = (r % 9) + 1;

    for (i = 0; i < n; i++)
    {
        if (a[i] % d == 0)
            count++;
    }

    printf("\nD = %d", d);
    printf("\nCount of values divisible by D = %d\n", count);

    return 0;
}
